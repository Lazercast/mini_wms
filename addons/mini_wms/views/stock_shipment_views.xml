<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Shipment List View -->
    <record id="view_wms_stock_shipment_list" model="ir.ui.view">
        <field name="name">wms.stock.shipment.list</field>
        <field name="model">wms.stock.shipment</field>
        <field name="arch" type="xml">
            <list string="Customer Shipments"
                  decoration-info="state == 'confirmed'"
                  decoration-success="state == 'shipped'"
                  decoration-muted="state == 'cancelled'"
                  sample="1">
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="customer"/>
                <field name="shipping_date"/>
                <field name="responsible_user_id" widget="many2one_avatar_user"/>
                <field name="total_quantity" sum="Total Shipped"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'shipped'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Stock Shipment Form View -->
    <record id="view_wms_stock_shipment_form" model="ir.ui.view">
        <field name="name">wms.stock.shipment.form</field>
        <field name="model">wms.stock.shipment</field>
        <field name="arch" type="xml">
            <form string="Customer Shipment">
                <header>
                    <button name="action_confirm" string="Confirm Order" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_ship" string="Ship Goods" type="object"
                            class="btn-success" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('shipped', 'cancelled')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,shipped"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Shipment Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Customer &amp; Dispatch">
                            <field name="customer" placeholder="e.g. Acme Tech Solutions Inc..."
                                   readonly="state in ('shipped', 'cancelled')"/>
                            <field name="warehouse_id" readonly="state in ('shipped', 'cancelled')"/>
                        </group>
                        <group string="Logistics">
                            <field name="shipping_date" readonly="state in ('shipped', 'cancelled')"/>
                            <field name="responsible_user_id" readonly="state in ('shipped', 'cancelled')"/>
                            <field name="total_quantity" readonly="1" class="fw-bold"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Items to Ship" name="lines">
                            <field name="line_ids" readonly="state in ('shipped', 'cancelled')">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="source_location_id"
                                           domain="[('warehouse_id', '=', parent.warehouse_id), ('location_type', 'in', ['storage', 'shipping'])]"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Shipping Notes" name="notes">
                            <field name="notes" placeholder="Waybill number, courier tracking, customer delivery requests..."/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Stock Shipment Search View -->
    <record id="view_wms_stock_shipment_search" model="ir.ui.view">
        <field name="name">wms.stock.shipment.search</field>
        <field name="model">wms.stock.shipment</field>
        <field name="arch" type="xml">
            <search string="Search Shipments">
                <field name="name"/>
                <field name="customer"/>
                <field name="warehouse_id"/>
                <field name="responsible_user_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed / Ready to Ship" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Shipped" name="shipped" domain="[('state', '=', 'shipped')]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer'}"/>
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Shipping Date" name="group_date" context="{'group_by': 'shipping_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Stock Shipment Action Window -->
    <record id="action_wms_stock_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">wms.stock.shipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wms_stock_shipment_search"/>
        <field name="context">{'search_default_confirmed': 1, 'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Dispatch an outbound shipment to a customer!
            </p>
            <p>
                Shipments reduce warehouse stock and trigger automated low-stock tasks if inventory drops below thresholds.
            </p>
        </field>
    </record>
</odoo>
