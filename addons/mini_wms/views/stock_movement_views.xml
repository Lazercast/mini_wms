<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Movement Ledger List View (Read-Only Audit Trail) -->
    <record id="view_wms_stock_movement_list" model="ir.ui.view">
        <field name="name">wms.stock.movement.list</field>
        <field name="model">wms.stock.movement</field>
        <field name="arch" type="xml">
            <list string="Stock Movement Ledger" create="0" edit="0" delete="0" sample="1">
                <field name="date"/>
                <field name="reference"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total Quantity"/>
                <field name="product_uom"/>
                <field name="route_display"/>
                <field name="operation_type" widget="badge"
                       decoration-success="operation_type == 'receipt'"
                       decoration-info="operation_type == 'transfer'"
                       decoration-primary="operation_type == 'shipment'"
                       decoration-warning="operation_type == 'adjustment'"/>
                <field name="responsible_user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <!-- Stock Movement Form View -->
    <record id="view_wms_stock_movement_form" model="ir.ui.view">
        <field name="name">wms.stock.movement.form</field>
        <field name="model">wms.stock.movement</field>
        <field name="arch" type="xml">
            <form string="Stock Movement Ledger Entry" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="display_name" string="Ledger Entry"/>
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Operation &amp; Document">
                            <field name="reference" readonly="1"/>
                            <field name="operation_type" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="responsible_user_id" readonly="1"/>
                        </group>
                        <group string="Product &amp; Movement Flow">
                            <field name="product_id" readonly="1"/>
                            <field name="quantity" readonly="1" class="fw-bold"/>
                            <field name="product_uom" readonly="1"/>
                            <field name="source_location_id" readonly="1"/>
                            <field name="destination_location_id" readonly="1"/>
                            <field name="route_display" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Stock Movement Search View -->
    <record id="view_wms_stock_movement_search" model="ir.ui.view">
        <field name="name">wms.stock.movement.search</field>
        <field name="model">wms.stock.movement</field>
        <field name="arch" type="xml">
            <search string="Search Stock Movements">
                <field name="product_id"/>
                <field name="reference"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="responsible_user_id"/>
                <separator/>
                <filter string="Receipts" name="receipt" domain="[('operation_type', '=', 'receipt')]"/>
                <filter string="Transfers" name="transfer" domain="[('operation_type', '=', 'transfer')]"/>
                <filter string="Shipments" name="shipment" domain="[('operation_type', '=', 'shipment')]"/>
                <filter string="Adjustments" name="adjustment" domain="[('operation_type', '=', 'adjustment')]"/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Operation Type" name="group_type" context="{'group_by': 'operation_type'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:day'}"/>
                    <filter string="Responsible" name="group_user" context="{'group_by': 'responsible_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Stock Movement Action Window -->
    <record id="action_wms_stock_movement" model="ir.actions.act_window">
        <field name="name">Stock Movements</field>
        <field name="res_model">wms.stock.movement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wms_stock_movement_search"/>
        <field name="context">{'search_default_group_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No movements recorded yet.
            </p>
            <p>
                Every receipt, internal transfer, shipment, or adjustment creates an immutable audit movement in this ledger.
            </p>
        </field>
    </record>
</odoo>
