<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Receipt List View -->
    <record id="view_wms_stock_receipt_list" model="ir.ui.view">
        <field name="name">wms.stock.receipt.list</field>
        <field name="model">wms.stock.receipt</field>
        <field name="arch" type="xml">
            <list string="Stock Receipts"
                  decoration-info="state == 'confirmed'"
                  decoration-success="state == 'received'"
                  decoration-muted="state == 'cancelled'"
                  sample="1">
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="source_supplier"/>
                <field name="receipt_date"/>
                <field name="responsible_user_id" widget="many2one_avatar_user"/>
                <field name="total_quantity" sum="Total Units"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'received'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Stock Receipt Form View -->
    <record id="view_wms_stock_receipt_form" model="ir.ui.view">
        <field name="name">wms.stock.receipt.form</field>
        <field name="model">wms.stock.receipt</field>
        <field name="arch" type="xml">
            <form string="Stock Receipt">
                <header>
                    <button name="action_confirm" string="Confirm Order" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_receive" string="Receive Goods" type="object"
                            class="btn-success" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('received', 'cancelled')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Receipt Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Source &amp; Destination">
                            <field name="warehouse_id" readonly="state in ('received', 'cancelled')"/>
                            <field name="source_supplier" placeholder="e.g. Dell Logistics, Acme Corp..."
                                   readonly="state in ('received', 'cancelled')"/>
                        </group>
                        <group string="Logistics Details">
                            <field name="receipt_date" readonly="state in ('received', 'cancelled')"/>
                            <field name="responsible_user_id" readonly="state in ('received', 'cancelled')"/>
                            <field name="total_quantity" readonly="1" class="fw-bold"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Items to Receive" name="lines">
                            <field name="line_ids" readonly="state in ('received', 'cancelled')">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="destination_location_id"
                                           domain="[('warehouse_id', '=', parent.warehouse_id), ('location_type', 'in', ['receiving', 'storage'])]"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" sum="Total Value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="notes" placeholder="Delivery slip number, carrier information, inspection notes..."/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Stock Receipt Search View -->
    <record id="view_wms_stock_receipt_search" model="ir.ui.view">
        <field name="name">wms.stock.receipt.search</field>
        <field name="model">wms.stock.receipt</field>
        <field name="arch" type="xml">
            <search string="Search Receipts">
                <field name="name"/>
                <field name="source_supplier"/>
                <field name="warehouse_id"/>
                <field name="responsible_user_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed / Ready" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Received" name="received" domain="[('state', '=', 'received')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('receipt_date', '=', context_today())]"/>
                <group expand="0" string="Group By">
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Supplier" name="group_supplier" context="{'group_by': 'source_supplier'}"/>
                    <filter string="Receipt Date" name="group_date" context="{'group_by': 'receipt_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Stock Receipt Action Window -->
    <record id="action_wms_stock_receipt" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="res_model">wms.stock.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wms_stock_receipt_search"/>
        <field name="context">{'search_default_confirmed': 1, 'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register an incoming shipment from a supplier!
            </p>
            <p>
                Receipts bring new products into your warehouse locations and generate automatic audit ledger movements.
            </p>
        </field>
    </record>
</odoo>
